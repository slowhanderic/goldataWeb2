# GoldataWeb2 — LOCAL (debug) settings for a developer machine. The ONE file for local work.
# Copy to deploy/env/local.env (git-ignored). Read by:
#   dotnet run --project src/Goldata.Api     (launch profile "local" → GOLDATA_ENV_FILE)
#   cd web && npm run dev                    (API_URL for the Vite proxy)
#   docker compose --env-file deploy/env/local.env -f deploy/compose.dev.yaml up -d   (local MariaDB)
# Relative paths are relative to THIS folder. Use only a SANITISED dump locally (NFR-DATA-1).
#
# Format rules: KEY=value · no quotes · comments only on their own line

# ---- environment ----
GOLDATA_ENV=local
ASPNETCORE_ENVIRONMENT=Development
API_URL=http://localhost:5080
PUBLIC_BASE_URL=http://localhost:5173

# ---- database: the local/test server 192.168.21.175 (DB copy), or 127.0.0.1 with deploy/compose.dev.yaml ----
# Use a DB account allowed from your machine (e.g. 'service_acct'@'<your host>'), never root. DB_APP_NAME must differ from DB_LEGACY_NAME.
DEV_DB_ROOT_PASSWORD=change-me
DB_HOST=192.168.21.175
DB_PORT=3307
DB_LEGACY_NAME=goldata
DB_APP_NAME=goldata_app
DB_API_USER=change-me
DB_API_PASSWORD=change-me
DB_MIGRATOR_USER=change-me
DB_MIGRATOR_PASSWORD=change-me
LEGACY_ENCODE_HTML=true
DB_UTF8MB4=false

# ---- documents / keys / logs ----
#DOCUMENTS_ROOT=../../.dev/docroot
DOCUMENTS_ROOT=/Volumes/web
DOCUMENTS_MAX_MB=80
DATA_PROTECTION_KEYS=../../.dev/keys
LOG_LEVEL=Debug
LOG_FILE=

# ---- security ----
TOKEN_PEPPER=local-dev-pepper-not-secret
SESSION_IDLE_MINUTES=480
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_TOKEN_DAYS=90
