# GoldataWeb2 — PROD settings. The ONE file for this environment: every setting, secrets included.
# On the NAS: copy to /volume1/docker/goldata/.env   then: sudo chown root:root .env && sudo chmod 600 .env
# Never commit the filled-in file.
#
# Format rules (read by docker-compose v1, goldata.sh and the API alike):
#   KEY=value  ·  no quotes  ·  no spaces around '='  ·  comments only on their own line
#   passwords: letters, digits and - _ . only (e.g. openssl rand -base64 33 | tr '+/' '-_' | tr -d '=')

# ---- environment ----
GOLDATA_ENV=prod
ASPNETCORE_ENVIRONMENT=Production

# ---- containers (docker-compose) ----
COMPOSE_PROJECT_NAME=goldata
REGISTRY=git.example.lan
API_TAG=1.0.0-0000000
WEB_TAG=1.0.0-0000000
# Local port the DSM reverse proxy forwards to (bound to 127.0.0.1 only).
WEB_PORT=8085
# Fixed Docker subnet: must match the MariaDB grants in db/ops/0001.
NETWORK_SUBNET=172.30.10.0/24
# Public URL (MCP client config, PHP change-password banner).
PUBLIC_BASE_URL=https://erp.example.com

# ---- database (existing MariaDB 10 package on the NAS) ----
DB_HOST=192.168.168.235
DB_PORT=3307
DB_LEGACY_NAME=goldata
DB_APP_NAME=goldata_app
DB_API_USER=goldata_api
DB_API_PASSWORD=change-me
DB_MIGRATOR_USER=goldata_migrator
DB_MIGRATOR_PASSWORD=change-me
DB_BACKUP_USER=goldata_backup
DB_BACKUP_PASSWORD=change-me
# Keep true while the PHP app is in use (Q7). DB_UTF8MB4 only after the DB is converted (Q6).
LEGACY_ENCODE_HTML=true
DB_UTF8MB4=false

# ---- documents (host folder that CONTAINS pdf_folder, and the owner of the PHP files: `id http`) ----
# Production NAS 192.168.168.235: pdf_folder at the root of its `web` share (confirm on .235 in P0).
DOC_ROOT=/volume1/web
DOC_UID=1023
DOC_GID=1023
DOCUMENTS_MAX_MB=80

# ---- security ----
TOKEN_PEPPER=change-me-48-random-chars
SESSION_IDLE_MINUTES=480
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_TOKEN_DAYS=90

# ---- logging ----
LOG_LEVEL=Information

# ---- legacy PHP login bridge (goldata.sh php-config writes PHP_AUTH_CONFIG from these) ----
DB_PHP_AUTH_USER=goldata_php_auth
DB_PHP_AUTH_PASSWORD=change-me
PHP_AUTH_DB_HOST=127.0.0.1
PHP_AUTH_CONFIG=/volume1/web_config/goldata_auth.php

# ---- backups (goldata.sh backup-db) ----
MARIADB_BIN=/usr/local/mariadb10/bin
BACKUP_DB_HOST=127.0.0.1
BACKUP_DIR=/volume1/backup/goldata
BACKUP_KEEP_DAYS=30
