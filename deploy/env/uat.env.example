# GoldataWeb2 — UAT settings. The ONE file for this environment: every setting, secrets included.
# On the NAS: copy to /volume1/docker/goldata-uat/.env   then: sudo chown root:root .env && sudo chmod 600 .env
# UAT runs beside prod on the same NAS: its own project name, port, subnet, databases, accounts and document copy,
# so it can NEVER write production data. Never commit the filled-in file.
#
# Format rules (read by docker-compose v1, goldata.sh and the API alike):
#   KEY=value  ·  no quotes  ·  no spaces around '='  ·  comments only on their own line
#   passwords: letters, digits and - _ . only

# ---- environment ----
GOLDATA_ENV=uat
ASPNETCORE_ENVIRONMENT=Staging

# ---- containers (docker-compose) ----
COMPOSE_PROJECT_NAME=goldata-uat
REGISTRY=git.example.lan
API_TAG=1.0.0-0000000
WEB_TAG=1.0.0-0000000
WEB_PORT=8086
# Must differ from prod and match the UAT grants in db/ops/0004.
NETWORK_SUBNET=172.30.11.0/24
PUBLIC_BASE_URL=https://erp-uat.example.com

# ---- database: UAT copies on the same MariaDB (db/ops/0004) ----
DB_HOST=192.168.168.235
DB_PORT=3307
DB_LEGACY_NAME=goldata_uat
DB_APP_NAME=goldata_app_uat
DB_API_USER=goldata_uat_api
DB_API_PASSWORD=change-me
DB_MIGRATOR_USER=goldata_uat_migrator
DB_MIGRATOR_PASSWORD=change-me
DB_BACKUP_USER=goldata_uat_backup
DB_BACKUP_PASSWORD=change-me
LEGACY_ENCODE_HTML=true
DB_UTF8MB4=false

# ---- documents: a COPY of pdf_folder for UAT (DEPLOYMENT.md "UAT") ----
# Outside the `web` share, so Web Station never serves it.
DOC_ROOT=/volume1/goldata-uat
DOC_UID=1023
DOC_GID=1023
DOCUMENTS_MAX_MB=80

# ---- security (different pepper from prod: prod tokens don't work on UAT) ----
TOKEN_PEPPER=change-me-48-random-chars-uat
SESSION_IDLE_MINUTES=480
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_TOKEN_DAYS=30

# ---- logging ----
LOG_LEVEL=Debug

# ---- legacy PHP login bridge (only if a UAT copy of the PHP site exists) ----
DB_PHP_AUTH_USER=goldata_uat_php_auth
DB_PHP_AUTH_PASSWORD=change-me
PHP_AUTH_DB_HOST=127.0.0.1
PHP_AUTH_CONFIG=/volume1/web_config/goldata_auth_uat.php

# ---- backups ----
MARIADB_BIN=/usr/local/mariadb10/bin
BACKUP_DB_HOST=127.0.0.1
BACKUP_DIR=/volume1/backup/goldata-uat
BACKUP_KEEP_DAYS=7
