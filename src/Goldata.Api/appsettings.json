{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Legacy": "",
    "App": "",
    "Migrator": ""
  },
  "Documents": {
    "RootPath": "/data/docroot",
    "MaxBytes": 83886080
  },
  "LegacyCompat": {
    "EncodeHtmlOnWrite": true,
    "Utf8mb4": false
  },
  "Auth": {
    "TokenPepper": "",
    "LockoutAttempts": 5,
    "LockoutMinutes": 15,
    "SessionIdleMinutes": 480,
    "MaxTokenDays": 90,
    "PublicBaseUrl": ""
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "ForwardedHeaders": {
    "KnownNetworks": ""
  }
}
